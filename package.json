{
  "name": "atbash-integrations",
  "private": true,
  "workspaces": [
    "packages/*",
    "packages/python-bridge",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:mcp": "npm run build -w @atbash/mcp",
    "build:eliza": "npm run build -w @atbash/eliza-plugin",
    "build:langgraph": "npm run build -w @atbash/langgraph",
    "build:autogen": "npm run build -w @atbash/autogen",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@atbash/sdk": "^0.3.8",
    "express": "^5.1.0"
  }
}
