{
  "name": "atbash-integrations",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:mcp": "npm run build -w @atbash/mcp",
    "build:eliza": "npm run build -w @atbash/eliza-plugin",
    "build:langgraph": "npm run build -w @atbash/langgraph",
    "typecheck": "tsc -p tsconfig.base.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "dependencies": {
    "@atbash/sdk": "file:atbash-sdk-0.3.6.tgz"
  }
}
